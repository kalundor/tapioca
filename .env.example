# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (injected by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_USER="app_user"
SQL_PASSWORD="app_password"
SQL_DB_NAME="postgres"
SQL_ADMIN_USER="admin_user"
SQL_ADMIN_PASSWORD="admin_password"

# Pluggy Open Finance API Credentials (replace with your real access in process.env / Secrets)
CLIENT_ID="YOUR_PLUGGY_CLIENT_ID"
CLIENT_SECRET="YOUR_PLUGGY_CLIENT_SECRET"
PLUGGY_CLIENT_ID="YOUR_PLUGGY_CLIENT_ID"
PLUGGY_CLIENT_SECRET="YOUR_PLUGGY_CLIENT_SECRET"
PLUGGY_API_KEY="YOUR_PLUGGY_API_KEY"
PLUGGY_CONNECT_TOKEN="YOUR_PLUGGY_CONNECT_TOKEN"

